PORT=8090
BRIDGE_TOKEN=change_this_bridge_pull_token
SYNC_EVERY_MINUTES=5
CACHE_FILE=./data/punch-cache.json

# JSON array: one object per machine.
# id must match HRMS Biometric Device -> Device ID.
# token should match HRMS Biometric Device -> API Token if using PUSH mode.
DEVICES_JSON=[{"id":"FACTORY-ZK-01","name":"Factory ESSL","ip":"192.168.1.201","port":4370,"locationName":"Factory","token":"factory_device_token"},{"id":"OFFICE-ZK-01","name":"Office ESSL","ip":"192.168.1.202","port":4370,"locationName":"Office","token":"office_device_token"}]

# Optional PUSH mode. Leave blank if HRMS will use HTTP_PULL.
# Example: http://localhost:5001/api/biometric/public-push
HRMS_PUSH_URL=
HRMS_PUSH_TOKEN=
