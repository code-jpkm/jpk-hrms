PORT=8090
BRIDGE_TOKEN=factory_bridge_admin_token
SYNC_EVERY_MINUTES=5
CACHE_FILE=./data/factory-push-cache.json
MAX_PUSH_BATCH=500
START_SYNC_ON_BOOT=true

# Factory fingerprint machine LAN details. Change IP to your real factory machine IP.
DEVICE_ID=FACTORY-ZK-01
DEVICE_NAME=Factory ESSL
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370
LOCATION_NAME=Factory

# This must match HRMS -> Biometric Devices -> Factory ESSL -> API Token
DEVICE_TOKEN=factory_device_token

# Central HRMS backend API URL reachable from the factory desktop.
# Localhost will NOT work if HRMS is not running on this factory desktop.
# Example production: https://hrms.yourcompany.com/api
# Example ngrok test: https://xxxxx.ngrok-free.app/api
HRMS_API_URL=http://YOUR-HRMS-SERVER:5001/api
